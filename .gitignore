backend/
frontend/
core_model/
eval/
tools/

# Archive and raw/heavy data
_archive_intermediate_files/
data/reference/raw/
data/raw/
data/model_runs/
data/simulation_runs/

# Track only lightweight final data outputs
data/*
!data/policy_comparisons/
!data/policy_comparisons/policy_comparison_20260721_110642.csv
!data/policy_comparisons/policy_comparison_20260721_110642.md
!data/scenario_comparisons/
