!data/token_cost_feasibility/token_cost_architecture_model_comparison.csv
!data/token_cost_feasibility/llm_pilot_usage_template.csv
!data/token_cost_feasibility/empirical_llm_pilot_*.csv
!data/token_cost_feasibility/empirical_llm_pilot_*_summary.json
!data/token_cost_feasibility/multi_agent_feasibility_*.csv
!data/token_cost_feasibility/multi_agent_feasibility_*_summary.json

# Ignore all scripts first, then allow selected research scripts
scripts/*
!scripts/generate_simulation_data.py
!scripts/generate_simulation_data_v2.py
!scripts/generate_simulation_data_v3.py
!scripts/run_simulation_scenarios.py
!scripts/run_simulation_scenarios_v2.py
!scripts/run_simulation_scenarios_v3.py
!scripts/compare_decision_policies.py
!scripts/build_analysis_report.py
!scripts/build_interactive_dashboard.py
!scripts/train_simulation_risk_model.py
!scripts/train_simulation_xgboost_model.py
!scripts/train_simulation_xgboost_optimized.py
!scripts/train_simulation_xgboost_v4_features_twostage.py
!scripts/train_simulation_xgboost_v5_true_twostage.py
!scripts/analyze_v5_twostage_sensitivity.py
!scripts/analyze_v5_recall_first_operating_points.py
!scripts/token_cost_feasibility.py
!scripts/run_llm_cost_pilot.py
!scripts/run_multi_agent_feasibility_pilot.py

# Reports: keep final/prototype/feasibility, ignore temporary exports
!reports/feasibility/empirical_llm_pilot_*.md
!reports/feasibility/multi_agent_feasibility_*.md
reports/**/*.tmp
~$*.docx

